{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOpenAISecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "${OPENAI_SECRET_ARN}"
    },
    {
      "Sid": "ReadAndRefreshThreadsSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "${THREADS_SECRET_ARN}"
    },
    {
      "Sid": "FindSocialHistory",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "social/history.json"
        }
      }
    },
    {
      "Sid": "ReadSocialInputs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::boston-weekend-agent-reports/events/latest.json",
        "arn:aws:s3:::boston-weekend-agent-reports/social/history.json",
        "arn:aws:s3:::boston-weekend-agent-reports/social/publications/threads/*"
      ]
    },
    {
      "Sid": "WriteSocialContent",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports/social/*"
    }
  ]
}
