{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEventProviderSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "${EVENTS_SECRET_ARN}"
    },
    {
      "Sid": "ReadPreviousEventSnapshot",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports/events/latest.json"
    },
    {
      "Sid": "WriteEventSnapshots",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports/events/*"
    }
  ]
}
