{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOpenAISecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "${OPENAI_SECRET_ARN}"
    },
    {
      "Sid": "ReadPipelineInputs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::boston-weekend-agent-reports/events/latest.json",
        "arn:aws:s3:::boston-weekend-agent-reports/weather/summary.json"
      ]
    },
    {
      "Sid": "WriteReports",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports/reports/*"
    }
  ]
}
