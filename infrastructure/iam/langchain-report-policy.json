{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOpenAISecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "${OPENAI_SECRET_ARN}"
    },
    {
      "Sid": "FindOptionalReportInputs",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "events/changes/latest.json",
            "reports/baselines/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadPipelineInputs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::boston-weekend-agent-reports/events/latest.json",
        "arn:aws:s3:::boston-weekend-agent-reports/events/changes/latest.json",
        "arn:aws:s3:::boston-weekend-agent-reports/weather/latest.json",
        "arn:aws:s3:::boston-weekend-agent-reports/weather/summary.json",
        "arn:aws:s3:::boston-weekend-agent-reports/reports/baselines/*",
        "arn:aws:s3:::boston-weekend-agent-reports/analytics/*"
      ]
    },
    {
      "Sid": "WriteAnalyticsHistory",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports/analytics/*"
    },
    {
      "Sid": "WriteReports",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports/reports/*"
    }
  ]
}
