{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontReadCurrentWeekendReport",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::boston-weekend-agent-reports/reports/weekend_summary.txt",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "${CLOUDFRONT_DISTRIBUTION_ARN}"
        }
      }
    }
  ]
}
