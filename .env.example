AWS_REGION=us-east-1
REPORT_BUCKET=boston-weekend-agent-reports
EVENTS_SECRET_ID=arn:aws:secretsmanager:us-east-1:123456789012:secret:boston-weekend-agent/events-api-EXAMPLE
OPENAI_SECRET_ID=arn:aws:secretsmanager:us-east-1:123456789012:secret:boston-weekend-agent/openai-EXAMPLE
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
REPORT_PROMPT_VERSION=v2
MAX_EVENTS_PER_SOURCE=10
MAX_CITY_EVENTS=30
MAX_MEET_BOSTON_EVENTS=30
MEET_BOSTON_DETAIL_LIMIT=12
MEET_BOSTON_CRAWL_DELAY_SECONDS=2
